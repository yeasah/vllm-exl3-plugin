+            elif not hasattr(param, "output_dim"):
+                # A parameter with no output_dim cannot be narrowed by
+                # _load_fused_module_from_checkpoint below, so hand it the whole
+                # tensor and let it split itself.
+                #
+                # Previously `type(param) in (RowvLLMParameter,
+                # BasevLLMParameter)`. That excluded subclasses, so an
+                # out-of-tree parameter with the same shape of problem fell
+                # through to the narrowing path and raised AttributeError on
+                # output_dim. hasattr states the actual requirement.
+                #
+                # Four in-tree classes lack output_dim, and this changes the
+                # behaviour of exactly one of them:
+                #   BasevLLMParameter, RowvLLMParameter -- named in the old
+                #     test, so unchanged.
+                #   PerTensorScaleParameter -- never reaches this test; the
+                #     isinstance branch above claims it first, at both call
+                #     sites.
+                #   SharedWeightParameter -- reaches it, and raises either way.
+                #     Before: falls through and raises AttributeError on
+                #     output_dim inside _load_fused_module_from_checkpoint.
+                #     After: its own load_merged_column_weight does
+                #     kwargs.pop("shard_id") and asserts in _shard_id_as_int,
+                #     because a fused id is None or a tuple, not "q"/"k"/"v".
+                #     So no working path is lost; only the exception changes,
+                #     and it now comes from the parameter rather than from
+                #     linear.py internals. It is also not reachable in current
+                #     use: SharedWeightParameter is created only by
+                #     compressed-tensors HadamardTransform, which refuses
+                #     tensor parallelism outright.
+                #
+                # loaded_shard_id is forwarded because splitting is impossible
+                # without it: it says *which* of this layer's output shards the
+                # tensor covers -- a tuple such as (0, 1, 2) when one checkpoint
+                # tensor holds several, or None when it holds all of them. The
+                # existing recipients take **kwargs and ignore it, so this is
+                # backward compatible.
+                param.load_merged_column_weight(
+                    loaded_weight=loaded_weight, shard_id=loaded_shard_id
+                )
                 return
             output_sizes = (
                 [self.output_sizes[idx] for idx in loaded_shard_id]
@@ -1192,8 +1230,12 @@ class QKVParallelLinear(ColumnParallelLinear):
                 for idx in range(param.data.shape[0]):
                     param.load_qkv_weight(loaded_weight=loaded_weight, shard_id=idx)
                 return
