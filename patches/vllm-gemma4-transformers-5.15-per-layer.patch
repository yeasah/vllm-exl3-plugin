+    def _per_layer_max(self, *names: str) -> int | None:
+        """Largest value of `names` across a heterogeneous config's layers.
+
+        transformers 5.15 marks attributes that differ per layer and raises
+        `AmbiguousGlobalPerLayerAttributeError` when they are read off the
+        top-level config. That is a `RuntimeError`, *not* an `AttributeError`,
+        so neither `getattr(cfg, name, default)` nor `hasattr` catches it and
+        every defensive read of such an attribute propagates.
+
+        Taking the max over the per-layer configs reproduces what the global
+        read returned before 5.15 for the models vLLM supports -- gemma-4-12B's
+        top-level `num_key_value_heads` is 8 and its per-layer values are
+        {1, 8} -- and matches what `get_num_experts_from_block_configs`
+        already does for NemotronH's heterogeneous blocks.
+
+        Returns None for homogeneous configs, which have no per_layer_config
+        and are unaffected by any of this.
+        """
+        per_layer = getattr(self.hf_text_config, "per_layer_config", None)
+        if not per_layer:
+            return None
+        values = [
+            value
+            for layer in per_layer
+            for name in names
+            if (value := getattr(layer, name, 0))
+        ]
+        return max(values) if values else None
+
     def get_total_num_kv_heads(self) -> int:
         attributes = [
             # For Falcon:
@@ -118,6 +147,9 @@ class ModelArchConfigConvertorBase:
             # For Step3p5:
             "num_attention_groups",
         ]
+        # Heterogeneous models vary this per layer; the global read raises.
+        if (per_layer := self._per_layer_max(*attributes)) is not None:
+            return per_layer
         # For non-grouped-query attention models, the number of KV heads is
         # equal to the number of attention heads.
         default_factory = self.get_total_num_attention_heads
@@ -605,6 +637,15 @@ class Gemma4ModelArchConfigConvertor(ModelArchConfigConvertorBase):
         # Gemma4 uses dual head dimensions: head_dim (sliding attention)
         # and global_head_dim (full attention).  Return the largest so
         # that attention backends allocate buffers large enough for both.
+        #
+        # transformers 5.15 models that heterogeneity explicitly: `head_dim` is
+        # a per-layer attribute, and reading it off the top-level config raises
+        # AmbiguousGlobalPerLayerAttributeError. That does *not* subclass
+        # AttributeError -- it is a RuntimeError -- so the `getattr` defaults
+        # below do not catch it. Ask the per-layer configs first, which is what
+        # the comment above was approximating anyway.
+        if (per_layer := self._per_layer_max("head_dim")) is not None:
+            return per_layer
         head_dim = getattr(self.hf_text_config, "head_dim", 0)
         global_head_dim = getattr(self.hf_text_config, "global_head_dim", 0)
         return max(head_dim, global_head_dim) or super().get_head_size()
