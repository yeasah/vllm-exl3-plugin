@@ -210,11 +210,28 @@ class Gemma4Config(VerifyAndUpdateConfig):
         When FA4 is not available we fall back to Triton.
         """
         hf_text_config = vllm_config.model_config.hf_text_config
-        head_dim = getattr(hf_text_config, "head_dim", None)
-        global_head_dim = getattr(hf_text_config, "global_head_dim", None)
-
-        if head_dim is None or global_head_dim is None or head_dim == global_head_dim:
-            return
+        # transformers 5.15 marks head_dim as per-layer for these models and
+        # raises AmbiguousGlobalPerLayerAttributeError on the global read. That
+        # is a RuntimeError, so the `getattr` defaults below do not catch it.
