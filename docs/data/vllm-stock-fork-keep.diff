+def kv_cache_margin_floor_bytes(device) -> int:
+    if current_platform.is_rocm():
+        return KV_CACHE_MARGIN_FLOOR_BYTES
+    _, total = device_memory_info(device)
+    return min(KV_CACHE_MARGIN_FLOOR_BYTES, max(KV_CACHE_MARGIN_FLOOR_MIN_BYTES, int(total * KV_CACHE_MARGIN_FLOOR_SHARE)))
