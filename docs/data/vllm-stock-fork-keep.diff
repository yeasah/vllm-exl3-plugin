+def kv_cache_non_torch_reserve_bytes(device) -> int:
+    if current_platform.is_rocm():
+        return KV_CACHE_NON_TORCH_RESERVE_BYTES
+    return min(KV_CACHE_NON_TORCH_RESERVE_BYTES, kv_cache_margin_floor_bytes(device) // 2)
+
+
+def kv_cache_keep_bytes(transient_peak_bytes, torch_reserve_growth_bytes, margin_floor_bytes=KV_CACHE_MARGIN_FLOOR_BYTES,
+                        margin_fraction=KV_CACHE_FORK_MARGIN_FRACTION, non_torch_reserve_bytes=KV_CACHE_NON_TORCH_RESERVE_BYTES):
